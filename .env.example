# Copie ce fichier en .env et adapte les valeurs

# --- Plateforme(s) à tester ---
# android (défaut) | ios | all
MW_PLATFORM=android

# --- Provider ---
# mobilecli (local, défaut) | mobilenext (Mobile Next Cloud)
MW_PROVIDER=mobilecli

# --- App à tester ---
MW_BUNDLE_ID=com.saucelabs.mydemoapp.android

# Chemin vers le .apk/.ipa à installer (laisser vide si déjà installée)
MW_APP_PATH=./apps/app-demo.apk

# --- Uniquement si MW_PROVIDER=mobilenext ---
# ⚠️ À adapter selon la doc officielle Mobile Next Cloud (mobilenext.ai)
MOBILENEXT_URL=
MOBILENEXT_API_KEY='mob_Z82kbaikMfPZNFrRb1YiQXp7pxseViu3EDne'

# --- Uniquement pour les scripts locaux ---
MW_AVD_NAME=Pixel_8
MW_IOS_DEVICE_NAME=iPhone 16
